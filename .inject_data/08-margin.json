{
  "domain": "价格表",
  "document": "价格表",
  "modules": [
    {
      "title": "当前批次与数据来源",
      "summary": "展示当前价格表批次的四项统计与价格标准包采集状态，支持后台重新生成今日批次并下载结果。",
      "content_md": "# 当前批次与数据来源（价格表）\n\n## 业务逻辑\n\n本模块回答「今天的价格表算好了吗、数据从哪来、能不能重算」。页面顶部展示当前批次的统计概览（扫描商品数、建议提价/降价、保持现价）与最近生成时间；旧口径批次回退展示负毛利、低毛利等旧统计口径，兼容查看。\n\n**数据来源**：价格表由淘宝与美团两个价格标准包计算而来。页面以摘要行展示各来源采集就绪状态，默认收起；来源采集中或存在异常时自动展开明细。异常来源按状态提供「重试」或「重新采集」入口，可触发定向补采；常见异常对应稳定错误码并附固定引导文案。只有全部来源就绪才允许重新生成。\n\n**重新生成**：点击「更新价格表」需二次确认——确认框明示需全量读取计算、耗时较长、任务在后台运行（刷新或切换页面不中断）、旧批次保留到新批次成功。确认后提交后台任务并轮询至终态，成功后自动静默刷新列表与历史批次。\n\n**下载**：批次已持久化时可下载当前批次价格表 xlsx（按钮文案按是否今日目标批次切换）；另可导出当前批次中报名爆好价商品的清单。来源未就绪或生成被阻断时显示状态提示，最近结果仍可查看。\n\n## API\n\n- `GET /api/v1/workbench/ops/margin/current` — 读取当前批次统计与就绪状态。\n- `GET /api/v1/workbench/ops/margin/sources` — 读取各价格标准包来源的采集就绪状态。\n- `POST /api/v1/workbench/ops/margin/generation-jobs` — 提交价格表后台重建任务（经 GET 同路径 /{runId} 轮询终态）。",
      "nfr_md": "- 来源采集中（存在 status=collecting）时前端每 5 秒串行轮询一次 /margin/sources，全部就绪后自动后台刷新列表与批次并停止轮询（OpsMargin.vue SOURCE_POLL_INTERVAL_MS）。\n- 价格表重建为长任务（界面预估 20–60 分钟），必须后台异步执行并支持跨页面轮询恢复；页面初始化与轮询请求均走 background+silent，不触发全局加载遮罩，上次快照先行渲染（推测：面向生产约 82 万条商品规模）。",
      "apis": [
        {
          "name": "查询当前批次（统计与就绪状态）",
          "api": "GET /api/v1/workbench/ops/margin/current",
          "request": [
            { "name": "itemScope", "type": "string", "required": false, "description": "商品范围，页面固定传 all（可选 valid / blocked）", "children": [] },
            { "name": "page", "type": "integer", "required": true, "description": "页码，从 1 开始", "children": [] },
            { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数", "children": [] }
          ],
          "response": [
            { "name": "batchId", "type": "string", "required": true, "description": "当前批次 ID", "children": [] },
            { "name": "batchTime", "type": "string", "required": true, "description": "批次生成时间，如 2026-07-30 06:00", "children": [] },
            { "name": "scannedProducts", "type": "integer", "required": true, "description": "扫描商品数", "children": [] },
            { "name": "priceUpCount", "type": "integer", "required": true, "description": "建议提价商品数", "children": [] },
            { "name": "priceDownCount", "type": "integer", "required": true, "description": "建议降价商品数", "children": [] },
            { "name": "priceKeepCount", "type": "integer", "required": true, "description": "保持现价商品数", "children": [] },
            { "name": "negativeCount", "type": "integer", "required": false, "description": "负毛利数（旧口径兼容字段）", "children": [] },
            { "name": "lowCount", "type": "integer", "required": false, "description": "低毛利数（旧口径兼容字段）", "children": [] },
            { "name": "highValueLowProfitCount", "type": "integer", "required": false, "description": "高价值低利润数（旧口径兼容字段）", "children": [] },
            { "name": "priceTableReady", "type": "boolean", "required": true, "description": "价格表口径是否就绪，决定统计展示口径", "children": [] },
            { "name": "persisted", "type": "boolean", "required": true, "description": "批次是否已持久化，未持久化不可下载", "children": [] },
            { "name": "sourceDataDate", "type": "string", "required": true, "description": "当前结果的数据业务日", "children": [] },
            { "name": "sourceStatus", "type": "string", "required": false, "description": "来源状态：ready / waiting_sources / stale_sources / not_scheduled", "children": [] },
            { "name": "blockers", "type": "array", "required": false, "description": "阻断生成的原因文案列表", "children": [
              { "name": "-", "type": "string", "required": false, "description": "阻断原因文案", "children": [] }
            ] }
          ]
        },
        {
          "name": "查询价格来源采集状态",
          "api": "GET /api/v1/workbench/ops/margin/sources",
          "request": [],
          "response": [
            { "name": "targetDate", "type": "string", "required": true, "description": "目标业务日，如 2026-08-08", "children": [] },
            { "name": "ready", "type": "boolean", "required": true, "description": "全部来源是否就绪，决定能否重新生成", "children": [] },
            { "name": "sources", "type": "array", "required": true, "description": "来源列表（淘宝/美团价格标准包）", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单个来源状态", "children": [
                { "name": "dataset", "type": "string", "required": true, "description": "数据集标识：taobao_activity_readonly / meituan_price_readonly", "children": [] },
                { "name": "name", "type": "string", "required": true, "description": "来源名称，如 淘宝价格表标准包", "children": [] },
                { "name": "channel", "type": "string", "required": true, "description": "渠道：TAOBAO / MEITUAN", "children": [] },
                { "name": "status", "type": "string", "required": true, "description": "采集状态：ready / collecting / blocked / missing", "children": [] },
                { "name": "businessDate", "type": "string", "required": false, "description": "已入库业务日", "children": [] },
                { "name": "receivedAt", "type": "string", "required": false, "description": "入库时间（ISO8601）", "children": [] },
                { "name": "reason", "type": "string", "required": false, "description": "稳定分流原因码，如 input_missing / collection_failed / platform_not_ready", "children": [] },
                { "name": "errorCode", "type": "string", "required": false, "description": "稳定采集错误码，如 REQUEST_BUDGET_EXCEEDED / DATASET_NOT_READY", "children": [] },
                { "name": "message", "type": "string", "required": true, "description": "面向用户的状态说明", "children": [] },
                { "name": "action", "type": "string", "required": false, "description": "建议的恢复动作", "children": [] }
              ] }
            ] },
            { "name": "blockers", "type": "array", "required": false, "description": "整体阻断原因列表", "children": [
              { "name": "-", "type": "string", "required": false, "description": "阻断原因文案", "children": [] }
            ] }
          ]
        },
        {
          "name": "提交价格表后台生成任务",
          "api": "POST /api/v1/workbench/ops/margin/generation-jobs",
          "request": [],
          "response": [
            { "name": "runId", "type": "string", "required": true, "description": "后台任务 ID，用于后续轮询 GET 同路径 /{runId}", "children": [] },
            { "name": "status", "type": "string", "required": true, "description": "任务状态：queued / running / succeeded / failed / blocked", "children": [] },
            { "name": "businessDate", "type": "string", "required": true, "description": "任务业务日", "children": [] },
            { "name": "message", "type": "string", "required": false, "description": "附加说明或失败原因", "children": [] }
          ]
        }
      ]
    },
    {
      "title": "价格表与批量调价",
      "summary": "全量商品价格大表（成本/原价/活动价/报名价/生效价/毛利/销量/处理建议/目标价），支持筛选、目标价录入与批量人工调价确认。",
      "content_md": "# 价格表与批量调价（价格表）\n\n## 业务逻辑\n\n本模块承载当前批次的商品价格大表，帮运营看清每个商品的价格与毛利现状并执行人工调价。表格按商品逐行展示成本、原价、活动价、报名价、生效价、毛利、毛利率与销量，生效价取各价格中的最低值，毛利为负时标红；系统按规则为每行给出处理建议（提价 / 降价 / 保持现价 / 人工复核），提价方向还会按成本与门店毛利目标给出建议价，降价方向只给方向、不给具体金额。\n\n**筛选与查询**：支持按关键词、门店、渠道、处理建议筛选，任一条件变化即回第一页重新查询。资料不全的待完善商品单独成表展示并说明待处理问题，记录保留、档案补齐后重新计算。\n\n**目标价录入**：每行可录入拟调整价；系统给出建议价时预填，人工编辑后按商品身份保留草稿，批次更新后草稿保留并在确认时重新核算。\n\n**批量调价**：勾选后进入批量调价，未填目标价的行会被跳过并提示数量。确认前逐项做收益预览（重新读取当前价格与成本，给出调整后毛利/利润），全部满足条件才能确认提交；调价凭预览令牌幂等确认入队，重复提交返回同一任务。结果逐项反馈已受理 / 正在核验（网络异常时假定可能已写入、禁止重投）/ 未能受理；调整后毛利为负的行会弹出警告，单次改价不会生效（存在更低活动价）时引导去活动报名记录处理。\n\n## API\n\n- `GET /api/v1/workbench/ops/margin/current` — 分页查询当前批次价格大表（含筛选、排序与待完善商品）。\n- `POST /api/v1/workbench/ops/price-adjustments/preview` — 按目标价生成只读收益预览。\n- `POST /api/v1/workbench/ops/price-adjustments/confirm` — 凭预览令牌幂等确认调价并入队执行。",
      "nfr_md": "- 列表服务端分页，每页 10/20/50/100 可选（默认 10）；同一列表并发刷新时只允许最后一次请求写入页面，避免慢响应覆盖用户已改筛选。\n- 批量调价预览以 2 个并发 worker 逐项拉取，单批规模受人工勾选限制（推测：防止同时打满预览接口）。\n- 调价确认必须携带服务端签发的 previewToken，目标价或对象变化即 409 拒绝，且同一 token 重复确认幂等返回同一任务（防重复写入平台）。",
      "apis": [
        {
          "name": "查询当前批次价格大表",
          "api": "GET /api/v1/workbench/ops/margin/current",
          "request": [
            { "name": "page", "type": "integer", "required": true, "description": "页码，从 1 开始", "children": [] },
            { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数（10/20/50/100）", "children": [] },
            { "name": "itemScope", "type": "string", "required": false, "description": "商品范围：all / valid / blocked，页面默认 all", "children": [] },
            { "name": "keyword", "type": "string", "required": false, "description": "SKU、商品名称或门店名称模糊搜索", "children": [] },
            { "name": "storeKey", "type": "string", "required": false, "description": "门店筛选键", "children": [] },
            { "name": "channel", "type": "string", "required": false, "description": "渠道筛选：TAOBAO / MEITUAN", "children": [] },
            { "name": "advice", "type": "string", "required": false, "description": "处理建议筛选：raise_price / lower_price / keep / review", "children": [] },
            { "name": "sortBy", "type": "string", "required": false, "description": "排序字段（列 prop）", "children": [] },
            { "name": "sortOrder", "type": "string", "required": false, "description": "排序方向：asc / desc", "children": [] }
          ],
          "response": [
            { "name": "items", "type": "array", "required": true, "description": "价格表行列表", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单个商品价格行", "children": [
                { "name": "itemId", "type": "string", "required": true, "description": "行项目 ID", "children": [] },
                { "name": "productName", "type": "string", "required": true, "description": "商品名称", "children": [] },
                { "name": "storeName", "type": "string", "required": true, "description": "门店（含渠道前缀，如 淘宝 · 重庆渝北空港店）", "children": [] },
                { "name": "storeKey", "type": "string", "required": true, "description": "门店键", "children": [] },
                { "name": "channel", "type": "string", "required": true, "description": "渠道：TAOBAO / MEITUAN", "children": [] },
                { "name": "skuCode", "type": "string", "required": true, "description": "商品 SKU 编码", "children": [] },
                { "name": "purchasePrice", "type": "number", "required": true, "description": "成本（采购价）", "children": [] },
                { "name": "originalPrice", "type": "number", "required": true, "description": "原价", "children": [] },
                { "name": "discountPrice", "type": "number", "required": false, "description": "活动价（折扣价），无则空", "children": [] },
                { "name": "registrationPrice", "type": "number", "required": false, "description": "报名价（爆好价活动价），无则空", "children": [] },
                { "name": "effectivePrice", "type": "number", "required": true, "description": "生效价（原价/活动价/报名价最低值）", "children": [] },
                { "name": "absoluteProfit", "type": "number", "required": true, "description": "毛利额（生效价+平台补贴−采购价−佣金）", "children": [] },
                { "name": "marginRate", "type": "string", "required": true, "description": "毛利率百分比文本，如 12.50%", "children": [] },
                { "name": "storeMonthSales", "type": "integer", "required": false, "description": "单店近30天销量", "children": [] },
                { "name": "marketMonthSales", "type": "integer", "required": false, "description": "全店（大盘）近30天销量", "children": [] },
                { "name": "processingAdvice", "type": "string", "required": false, "description": "处理建议：raise_price / lower_price / keep / review / raise_or_explosive_product / explosive_product_review", "children": [] },
                { "name": "suggestedPrice", "type": "string", "required": false, "description": "后端按成本与门店毛利目标计算的建议价（仅提价方向给出）", "children": [] },
                { "name": "breakEvenPrice", "type": "string", "required": false, "description": "保本价", "children": [] },
                { "name": "adjustmentReason", "type": "string", "required": false, "description": "建议原因说明", "children": [] }
              ] }
            ] },
            { "name": "itemTotal", "type": "integer", "required": true, "description": "当前筛选条件下的总条数", "children": [] },
            { "name": "blockedItems", "type": "array", "required": false, "description": "待完善商品列表", "children": [
              { "name": "-", "type": "object", "required": true, "description": "待完善商品记录", "children": [
                { "name": "itemId", "type": "string", "required": true, "description": "行项目 ID", "children": [] },
                { "name": "productName", "type": "string", "required": true, "description": "商品名称", "children": [] },
                { "name": "storeName", "type": "string", "required": true, "description": "门店", "children": [] },
                { "name": "skuCode", "type": "string", "required": true, "description": "商品编码", "children": [] },
                { "name": "reason", "type": "string", "required": true, "description": "需要处理的问题（缺失字段说明）", "children": [] }
              ] }
            ] }
          ]
        },
        {
          "name": "调价收益预览",
          "api": "POST /api/v1/workbench/ops/price-adjustments/preview",
          "request": [
            { "name": "domain", "type": "string", "required": true, "description": "调价范围：价格表固定 margin（亏损为 loss）", "children": [] },
            { "name": "itemKey", "type": "string", "required": true, "description": "行项目 ID", "children": [] },
            { "name": "productKey", "type": "string", "required": false, "description": "商品键（SKU）", "children": [] },
            { "name": "targetPrice", "type": "string", "required": false, "description": "拟调整目标价；缺省时回退采用建议价", "children": [] }
          ],
          "response": [
            { "name": "previewToken", "type": "string", "required": true, "description": "预览令牌，绑定本次用户、对象、价格与当前事实，确认时必传", "children": [] },
            { "name": "eligible", "type": "boolean", "required": true, "description": "是否满足确认条件（无有效目标价时为 false）", "children": [] },
            { "name": "reason", "type": "string", "required": false, "description": "不可确认的原因说明", "children": [] },
            { "name": "blockCode", "type": "string", "required": false, "description": "阻断码，如 target_not_effective / ambiguous_effective_activity", "children": [] },
            { "name": "currentPrice", "type": "string", "required": true, "description": "平台当前价", "children": [] },
            { "name": "targetPrice", "type": "string", "required": false, "description": "拟调整价", "children": [] },
            { "name": "suggestedPrice", "type": "string", "required": false, "description": "系统建议价", "children": [] },
            { "name": "breakEvenPrice", "type": "string", "required": false, "description": "保本价", "children": [] },
            { "name": "cost", "type": "string", "required": true, "description": "当前成本", "children": [] },
            { "name": "profitBefore", "type": "string", "required": true, "description": "调整前单件利润", "children": [] },
            { "name": "profitAfter", "type": "string", "required": false, "description": "调整后单件利润", "children": [] },
            { "name": "marginBefore", "type": "string", "required": false, "description": "调整前毛利率（百分比文本）", "children": [] },
            { "name": "marginAfter", "type": "string", "required": false, "description": "调整后毛利率（百分比文本）", "children": [] },
            { "name": "priceType", "type": "string", "required": false, "description": "当前价价格类型，如 当前平台售价", "children": [] },
            { "name": "profitBasis", "type": "string", "required": false, "description": "利润口径说明（未计入订单优惠、配送费等）", "children": [] }
          ]
        },
        {
          "name": "确认调价并入队",
          "api": "POST /api/v1/workbench/ops/price-adjustments/confirm",
          "request": [
            { "name": "domain", "type": "string", "required": true, "description": "调价范围：margin", "children": [] },
            { "name": "itemKey", "type": "string", "required": true, "description": "行项目 ID，须与预览一致", "children": [] },
            { "name": "productKey", "type": "string", "required": false, "description": "商品键，须与预览一致", "children": [] },
            { "name": "targetPrice", "type": "string", "required": true, "description": "拟调整价，须与预览完全一致，否则 409", "children": [] },
            { "name": "previewToken", "type": "string", "required": true, "description": "预览接口签发的令牌，服务端据此幂等入队", "children": [] }
          ],
          "response": [
            { "name": "revisionId", "type": "string", "required": true, "description": "目标价版本 ID", "children": [] },
            { "name": "attemptId", "type": "string", "required": true, "description": "调价任务 ID，用于查询执行与读回结果", "children": [] },
            { "name": "status", "type": "string", "required": true, "description": "受理状态：queued / succeeded / blocked / unknown / failed", "children": [] }
          ]
        }
      ]
    },
    {
      "title": "历史记录",
      "summary": "按批次保留价格表生成历史，支持查看批次统计详情与按批次时间命名下载。",
      "content_md": "# 历史记录（价格表）\n\n## 业务逻辑\n\n本模块按批次保留价格表生成历史（按日生成，通常早间出批），供运营回溯对比与下载归档。列表逐批展示生成时间、扫描商品数与建议提价/降价/保持现价统计；旧口径批次回退展示负毛利、低毛利等旧统计，新旧口径混合时统一切换展示口径。\n\n**查看**：点击「查看」打开批次信息弹窗，展示数据业务日、批次状态（有待关注项时突出数量，否则为已完成）与各项统计。\n\n**下载**：按批次导出价格表 xlsx，文件名按批次生成时间命名（不取下载时间）；下载后校验字节完整性，不完整视为失败。旧批次在新批次生成成功前一直保留，当前批次的下载也复用同一正式批次下载接口。\n\n**与规则的关系**：规则保存只影响后续新生成的批次，历史批次结果不会重新计算。\n\n## API\n\n- `GET /api/v1/workbench/ops/margin/batches` — 查询全部历史批次及统计。\n- `GET /api/v1/workbench/ops/margin/batches/{id}` — 查询单个批次详情，用于批次信息弹窗。",
      "nfr_md": "- 批次列表一次全量返回、前端分页（默认每页 3 条），假定批次规模有限（按日生成，推测年量级数百条可接受）。\n- 历史下载文件需按响应头声明的字节数校验完整性，不完整则视为失败（推测：防止大文件截断后被当作有效价格表使用）。",
      "apis": [
        {
          "name": "查询历史批次列表",
          "api": "GET /api/v1/workbench/ops/margin/batches",
          "request": [],
          "response": [
            { "name": "-", "type": "array", "required": true, "description": "批次数组（响应体即数组）", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单个批次摘要", "children": [
                { "name": "batchId", "type": "string", "required": true, "description": "批次 ID", "children": [] },
                { "name": "batchTime", "type": "string", "required": true, "description": "批次生成时间", "children": [] },
                { "name": "scannedProducts", "type": "integer", "required": true, "description": "扫描商品数", "children": [] },
                { "name": "priceUpCount", "type": "integer", "required": true, "description": "建议提价数", "children": [] },
                { "name": "priceDownCount", "type": "integer", "required": true, "description": "建议降价数", "children": [] },
                { "name": "priceKeepCount", "type": "integer", "required": true, "description": "保持现价数", "children": [] },
                { "name": "negativeCount", "type": "integer", "required": false, "description": "负毛利数（旧口径）", "children": [] },
                { "name": "lowCount", "type": "integer", "required": false, "description": "低毛利数（旧口径）", "children": [] },
                { "name": "highValueLowProfitCount", "type": "integer", "required": false, "description": "高价值低利润数（旧口径）", "children": [] },
                { "name": "priceTableReady", "type": "boolean", "required": true, "description": "该批次是否为价格表口径", "children": [] }
              ] }
            ] }
          ]
        },
        {
          "name": "查询批次详情",
          "api": "GET /api/v1/workbench/ops/margin/batches/{id}",
          "request": [
            { "name": "id", "type": "string", "required": true, "description": "批次 ID（路径参数）", "children": [] }
          ],
          "response": [
            { "name": "batchId", "type": "string", "required": true, "description": "批次 ID", "children": [] },
            { "name": "batchTime", "type": "string", "required": true, "description": "批次生成时间", "children": [] },
            { "name": "scannedProducts", "type": "integer", "required": true, "description": "扫描商品数", "children": [] },
            { "name": "priceUpCount", "type": "integer", "required": true, "description": "建议提价数", "children": [] },
            { "name": "priceDownCount", "type": "integer", "required": true, "description": "建议降价数", "children": [] },
            { "name": "priceKeepCount", "type": "integer", "required": true, "description": "保持现价数", "children": [] },
            { "name": "priceTableReady", "type": "boolean", "required": true, "description": "是否为价格表口径批次", "children": [] },
            { "name": "sourceDataDate", "type": "string", "required": false, "description": "数据业务日", "children": [] },
            { "name": "pendingCount", "type": "integer", "required": false, "description": "待关注条目数，>0 时状态显示「待关注 N」", "children": [] }
          ]
        }
      ]
    },
    {
      "title": "运营备注与规则设置",
      "summary": "维护跨批次生效的运营经验备注，以及按渠道（淘宝/美团）分别配置阈值与启停的价格判定规则。",
      "content_md": "# 运营备注与规则设置（价格表）\n\n## 业务逻辑\n\n本模块维护两类跨批次生效的运营配置：经验备注与价格判定规则，二者都从下一个批次开始生效，不回溯重算当前与历史结果。\n\n**运营备注**：页面底部常驻多行文本，用于沉淀运营经验（如引流品判断口径、补贴缺失行的处理约定），保存即从后续批次生效。\n\n**规则设置**：通过弹窗按渠道（淘宝 / 美团）分别配置各条判定规则的阈值与启停；某渠道未单独配置时按统一阈值惰性初始化。数据未就绪的规则（如高价值品最低单件利润，会议未量化、当前不参与自动判断）禁止编辑；部分规则构成启停联动组，改动任一条的开关，同组规则一起启停。\n\n**保存**：规则整体提交保存，保存前弹确认提示「只影响后续新生成批次，当前批次与历史结果不会重新计算」，保存成功后重新拉取最新配置。\n\n## API\n\n- `GET /api/v1/workbench/ops/margin/rules` — 读取价格判定规则（含分渠道阈值与启停）。\n- `PUT /api/v1/workbench/ops/margin/rules` — 整体保存规则配置，下一批次起生效。\n- `PUT /api/v1/workbench/ops/margin/experience` — 保存运营备注（读取用 GET 同路径）。",
      "nfr_md": "- 规则保存为整体替换式 PUT，需携带全部规则的完整配置（含未修改项），避免部分更新丢配置（推测，依据请求体形状）。\n- 规则与备注的生效粒度为「批次」：保存不触发任何重算，只在下次生成时被读取（代码确认文案）。",
      "apis": [
        {
          "name": "查询价格规则",
          "api": "GET /api/v1/workbench/ops/margin/rules",
          "request": [],
          "response": [
            { "name": "-", "type": "array", "required": true, "description": "规则数组（响应体即数组）", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单条规则", "children": [
                { "name": "ruleKey", "type": "string", "required": true, "description": "规则标识，如 low-margin-rate / market-sales-floor", "children": [] },
                { "name": "name", "type": "string", "required": true, "description": "规则名，如 低毛利率线", "children": [] },
                { "name": "desc", "type": "string", "required": true, "description": "判定说明", "children": [] },
                { "name": "threshold", "type": "number", "required": true, "description": "统一阈值（分渠道未配置时的缺省值）", "children": [] },
                { "name": "unit", "type": "string", "required": true, "description": "阈值单位：% / 元 / 单", "children": [] },
                { "name": "enabled", "type": "boolean", "required": true, "description": "是否启用", "children": [] },
                { "name": "dataReady", "type": "boolean", "required": true, "description": "数据是否就绪，false 时禁止编辑", "children": [] },
                { "name": "channelRules", "type": "object", "required": false, "description": "分渠道阈值与启停（key：taobao / meituan）", "children": [
                  { "name": "taobao", "type": "object", "required": false, "description": "淘宝渠道配置", "children": [
                    { "name": "threshold", "type": "number", "required": true, "description": "渠道阈值（≥0）", "children": [] },
                    { "name": "enabled", "type": "boolean", "required": true, "description": "渠道启停", "children": [] }
                  ] },
                  { "name": "meituan", "type": "object", "required": false, "description": "美团渠道配置", "children": [
                    { "name": "threshold", "type": "number", "required": true, "description": "渠道阈值（≥0）", "children": [] },
                    { "name": "enabled", "type": "boolean", "required": true, "description": "渠道启停", "children": [] }
                  ] }
                ] }
              ] }
            ] }
          ]
        },
        {
          "name": "保存价格规则",
          "api": "PUT /api/v1/workbench/ops/margin/rules",
          "request": [
            { "name": "-", "type": "array", "required": true, "description": "规则数组（请求体即数组，整体替换）", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单条规则配置", "children": [
                { "name": "ruleKey", "type": "string", "required": true, "description": "规则标识", "children": [] },
                { "name": "threshold", "type": "number", "required": true, "description": "统一阈值", "children": [] },
                { "name": "enabled", "type": "boolean", "required": true, "description": "是否启用", "children": [] },
                { "name": "storeThresholds", "type": "object", "required": false, "description": "分门店阈值（storeKey → 阈值），价格表版界面未暴露编辑", "children": [] },
                { "name": "excludedStoreKeys", "type": "array", "required": false, "description": "排除的门店键列表", "children": [
                  { "name": "-", "type": "string", "required": false, "description": "门店键", "children": [] }
                ] },
                { "name": "channelRules", "type": "object", "required": false, "description": "分渠道阈值与启停（taobao / meituan）", "children": [
                  { "name": "taobao", "type": "object", "required": false, "description": "淘宝渠道配置", "children": [
                    { "name": "threshold", "type": "number", "required": true, "description": "渠道阈值", "children": [] },
                    { "name": "enabled", "type": "boolean", "required": true, "description": "渠道启停", "children": [] }
                  ] },
                  { "name": "meituan", "type": "object", "required": false, "description": "美团渠道配置", "children": [
                    { "name": "threshold", "type": "number", "required": true, "description": "渠道阈值", "children": [] },
                    { "name": "enabled", "type": "boolean", "required": true, "description": "渠道启停", "children": [] }
                  ] }
                ] }
              ] }
            ] }
          ],
          "response": [
            { "name": "-", "type": "array", "required": true, "description": "保存后的规则数组（形状同 GET /rules）", "children": [
              { "name": "-", "type": "object", "required": true, "description": "单条规则（ruleKey、threshold、enabled、channelRules 等）", "children": [
                { "name": "ruleKey", "type": "string", "required": true, "description": "规则标识", "children": [] },
                { "name": "threshold", "type": "number", "required": true, "description": "生效阈值", "children": [] },
                { "name": "enabled", "type": "boolean", "required": true, "description": "是否启用", "children": [] }
              ] }
            ] }
          ]
        },
        {
          "name": "保存运营备注",
          "api": "PUT /api/v1/workbench/ops/margin/experience",
          "request": [
            { "name": "content", "type": "string", "required": true, "description": "运营经验备注全文（多行文本）", "children": [] }
          ],
          "response": [
            { "name": "message", "type": "string", "required": true, "description": "保存结果文案：经验已保存，从下一个批次开始生效", "children": [] }
          ]
        }
      ]
    }
  ]
}
