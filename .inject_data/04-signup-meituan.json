    },
    {
      "title": "报名确认与报名记录",
      "summary": "确认弹窗逐项核对申报价/每日数量/限购后幂等提交报名；报名记录抽屉跟踪执行状态、平台对账，并支持撤回与撤销后重新报价。",
      "content_md": "# 报名确认与报名记录（美团报名）\n\n## 业务逻辑\n\n勾选商品后经确认弹窗逐项核对并提交报名，结果进入「报名记录」抽屉跟踪执行状态与平台对账。\n\n- 前置校验：报名按活动分批提交，跨活动勾选、实时候选与历史清单混报都会被拦截；每行的申报价、每日数量、每人限购必须齐全合规——价格在当前可报范围内、数量在当前可售库存区间内、限购同批统一。无可信库存或改了价未完成试算的行不能确认。\n- 确认弹窗：逐行展示申报价、数量、限购、补贴证据、到手价、成本、利润与建议；任一商品不合规时禁止提交并给出具体原因。\n- 幂等提交：每次打开弹窗生成一次幂等令牌，弹窗内重试复用同一令牌，不会重复落库；单次确认有数量上限。实时美团候选只回传服务端冻结的候选 ID 与运营核对的三值（申报价/日库存/限购），身份由服务端快照决定。预检拒绝（活动截止、超价格上限、成本未就绪、重复令牌等）逐行给出原因，被拒行保留人工输入与试算供修正，已受理行即时清理避免串单。\n- 报名记录抽屉：按商品跟踪执行状态——已确认待执行、执行中、报名成功、提交被拒、结果核实中、已撤销、撤销被拒、撤回核实中等；凡“核实中”状态必须继续核验结果，绝不能重发，以免重复报名。\n- 行操作：「计算详情」回读该次确认的快照（含智能探测逐价样本）；撤回仅对报名成功或撤回核实中的记录开放，撤销目标只使用平台返回的真实门店键，禁止猜测；已撤销的记录可「重新报价」生成重报草稿，草稿令牌先持久化到本地再请求，避免响应丢失后换令牌被判重复。实时美团候选不能用旧草稿重发，必须重新读取活动、门店和商品后创建新确认。\n- 平台报名核对（对账）：抽屉下半块按门店×条码展示对账结果，分报名成功、平台有我无（疑似重复或平台侧人工报名）、待对账三态并汇总计数；确认受理后行先落“待对账”，后台对账任务读回平台结果后再回写。\n\n## API\n\n- `POST /api/v2/signup/confirms` — 确认受理（落工作单）；实时美团候选传候选 ID+三值。\n- `GET /api/v2/signup/confirms` — 报名记录列表（按确认记录聚合摘要，含逐商品状态）。\n- `GET /api/v2/signup/reconciliations` — 平台报名核对结果与三态汇总。",
      "nfr_md": "- 幂等令牌 8–128 位，24 小时去重窗口内重试不重复落库；重放仅允许完全相同的已验证方案（代码证据：`newConfirmToken` 注释与 mock `tokenWindow` 校验）。\n- 单次确认上限 500 件，普通勾选与重新处理共用同一上限（代码证据：`SIGNUP_SELECTION_LIMIT=500` 及 mock 422）。\n- 报名记录分页默认 20 条/页、对账默认 50 条/页，超页自动回退到末页（代码证据）。",
      "apis": [
        {
          "name": "确认报名",
          "api": "POST /api/v2/signup/confirms",
          "request": [
            { "name": "activityId", "type": "string", "required": true, "description": "活动 ID；跨活动勾选被服务端 409 拒绝", "children": [] },
            { "name": "clientConfirmToken", "type": "string", "required": true, "description": "幂等令牌（8–128 位，UUID）；24h 去重窗口内重试复用", "children": [] },
            {
              "name": "liveMeituanInputs", "type": "array", "required": true, "description": "实时美团候选确认项；只传服务端候选 ID 与运营填写三值，不传 SKU/门店/活动身份；与历史清单来源互斥，单次最多 500 件",
              "children": [
                { "name": "candidateSnapshotId", "type": "string", "required": true, "description": "服务端冻结的候选 ID", "children": [] },
                { "name": "applyPrice", "type": "string", "required": true, "description": "申报价（元，两位小数字符串），须在可报范围内", "children": [] },
                { "name": "actDayStock", "type": "string", "required": true, "description": "每日数量（正整数字符串），须在当前可售库存区间内", "children": [] },
                { "name": "orderBuyLimit", "type": "string", "required": true, "description": "每人限购（正整数字符串），同批统一", "children": [] },
                { "name": "confirmed", "type": "boolean", "required": true, "description": "逐项人工核对标记，必须为 true", "children": [] }
              ]
            }
          ],
          "response": [
            { "name": "confirmKey", "type": "string", "required": true, "description": "确认记录键，如 SC-20260903-0001", "children": [] },
            { "name": "precheckStatus", "type": "string", "required": true, "description": "预检状态，如 passed / missing", "children": [] },
            { "name": "itemCount", "type": "integer", "required": true, "description": "已受理商品数（只计已冻结快照的行）", "children": [] },
            { "name": "submissionStatus", "type": "string", "required": true, "description": "提交状态：work_order / queued / submitted / submit_failed / submit_unknown / cancelled 等", "children": [] },
            { "name": "executionStatus", "type": "string", "required": false, "description": "后台执行与读回的逐项状态；unknown 必须继续核验不能重发", "children": [] },
            { "name": "confirmationSource", "type": "string", "required": false, "description": "确认来源；user 表示服务端认证入口写入的人工确认", "children": [] },
            {
              "name": "rejectedItems", "type": "array", "required": true, "description": "逐行拒绝明细",
              "children": [
                { "name": "itemId", "type": "string", "required": true, "description": "被拒行 ID", "children": [] },
                { "name": "reason", "type": "string", "required": true, "description": "拒绝原因", "children": [] }
              ]
            }
          ]
        },
        {
          "name": "报名记录列表",
          "api": "GET /api/v2/signup/confirms",
          "request": [
            { "name": "page", "type": "integer", "required": true, "description": "页码", "children": [] },
            { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数，记录页默认 20", "children": [] },
            { "name": "platform", "type": "string", "required": false, "description": "平台筛选，如 meituan", "children": [] },
            { "name": "activityId", "type": "string", "required": false, "description": "活动筛选", "children": [] },
            { "name": "submissionStatus", "type": "string", "required": false, "description": "提交状态筛选", "children": [] },
            { "name": "businessDate", "type": "string", "required": false, "description": "业务日筛选", "children": [] }
          ],
          "response": [
            {
              "name": "items", "type": "array", "required": true, "description": "确认记录（confirmKey 聚合摘要）",
              "children": [
                { "name": "confirmKey", "type": "string", "required": true, "description": "确认记录键", "children": [] },
                { "name": "platform", "type": "string", "required": true, "description": "平台", "children": [] },
                { "name": "activityId", "type": "string", "required": true, "description": "活动 ID", "children": [] },
                { "name": "activityName", "type": "string", "required": true, "description": "活动名称", "children": [] },
                { "name": "businessDate", "type": "string", "required": true, "description": "业务日", "children": [] },
                { "name": "itemCount", "type": "integer", "required": true, "description": "商品数", "children": [] },
                { "name": "precheckStatus", "type": "string", "required": true, "description": "预检状态", "children": [] },
                { "name": "submissionStatus", "type": "string", "required": true, "description": "提交状态", "children": [] },
                { "name": "executionStatus", "type": "string", "required": false, "description": "执行/读回状态", "children": [] },
                { "name": "confirmedBy", "type": "string", "required": true, "description": "操作人", "children": [] },
                { "name": "confirmedAt", "type": "string", "required": true, "description": "确认时间（ISO）", "children": [] },
                {
                  "name": "products", "type": "array", "required": false, "description": "逐商品摘要（记录表按商品展开）",
                  "children": [
                    { "name": "rowId", "type": "string", "required": true, "description": "确认行 ID", "children": [] },
                    { "name": "source", "type": "string", "required": false, "description": "来源：live_candidate / list_item", "children": [] },
                    { "name": "storeKey", "type": "string", "required": true, "description": "门店键", "children": [] },
                    { "name": "productName", "type": "string", "required": true, "description": "商品名称", "children": [] },
                    { "name": "barcode", "type": "string", "required": true, "description": "条码", "children": [] },
                    { "name": "originalPrice", "type": "number", "required": false, "description": "原价（元）", "children": [] },
                    { "name": "activityPrice", "type": "number", "required": false, "description": "报名价（元）", "children": [] },
                    { "name": "cost", "type": "number", "required": false, "description": "成本（元）", "children": [] },
                    { "name": "submissionStatus", "type": "string", "required": true, "description": "该行提交状态", "children": [] },
                    { "name": "failureReason", "type": "string", "required": false, "description": "平台失败原因（仅精确关联后展示）", "children": [] }
                  ]
                }
              ]
            },
            { "name": "page", "type": "integer", "required": true, "description": "当前页码", "children": [] },
            { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数", "children": [] },
            { "name": "total", "type": "integer", "required": true, "description": "记录总数", "children": [] }
          ]
        },
        {
          "name": "平台报名核对（对账）",
          "api": "GET /api/v2/signup/reconciliations",
          "request": [
            { "name": "page", "type": "integer", "required": true, "description": "页码", "children": [] },
            { "name": "pageSize", "type": "integer", "required": true, "description": "每页条数，对账默认 50", "children": [] },
            { "name": "businessDate", "type": "string", "required": false, "description": "业务日筛选", "children": [] },
            { "name": "platform", "type": "string", "required": false, "description": "平台筛选", "children": [] },
            { "name": "activityId", "type": "string", "required": false, "description": "活动筛选", "children": [] },
            { "name": "matchStatus", "type": "string", "required": false, "description": "对账状态筛选：matched / platform_only / confirm_only", "children": [] },
            { "name": "confirmKey", "type": "string", "required": false, "description": "按确认记录筛选", "children": [] }
          ],
          "response": [
            {
              "name": "items", "type": "array", "required": true, "description": "对账行（门店×条码粒度）",
              "children": [
                { "name": "businessDate", "type": "string", "required": true, "description": "业务日", "children": [] },
                { "name": "platform", "type": "string", "required": true, "description": "平台", "children": [] },
                { "name": "activityId", "type": "string", "required": true, "description": "活动 ID", "children": [] },
                { "name": "activityName", "type": "string", "required": true, "description": "活动名称", "children": [] },
                { "name": "storeKey", "type": "string", "required": true, "description": "门店键", "children": [] },
                { "name": "barcode", "type": "string", "required": true, "description": "商品条码", "children": [] },
                { "name": "matchStatus", "type": "string", "required": true, "description": "对账三态：matched 报名成功 / platform_only 平台有我无 / confirm_only 待对账", "children": [] },
                { "name": "platformStatus", "type": "string", "required": false, "description": "平台侧状态，如 已报名", "children": [] },
                { "name": "confirmKey", "type": "string", "required": false, "description": "关联的确认记录键", "children": [] },
                { "name": "failureReason", "type": "string", "required": false, "description": "失败/异常原因说明", "children": [] },
                { "name": "reconciledAt", "type": "string", "required": true, "description": "对账时间（ISO）", "children": [] }
              ]
            },
            {
              "name": "summary", "type": "object", "required": true, "description": "三态聚合计数（全量口径，不随分页截断）",
              "children": [
                { "name": "matched", "type": "integer", "required": true, "description": "报名成功数", "children": [] },
                { "name": "platform_only", "type": "integer", "required": true, "description": "平台有我无数", "children": [] },
                { "name": "confirm_only", "type": "integer", "required": true, "description": "待对账数", "children": [] }
              ]
            },
            { "name": "total", "type": "integer", "required": true, "description": "对账行总数", "children": [] }
          ]
        }
      ]
    }
  ]
}
